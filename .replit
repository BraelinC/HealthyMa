modules = ["nodejs-20", "web", "postgresql-16", "python-3.11"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"
packages = ["openssh", "pkg-config", "glib", "nss", "atk", "gtk3", "cups", "mesa", "expat", "alsa-lib", "libxkbcommon", "xorg.libX11", "xorg.libXcomposite", "xorg.libXdamage", "xorg.libXext", "xorg.libXfixes", "xorg.libXrandr"]

[deployment]
deploymentTarget = "autoscale"
build = ["npm", "run", "build"]
run = ["npm", "run", "start"]

[[ports]]
localPort = 4983
externalPort = 6800

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 8000

[[ports]]
localPort = 5173
externalPort = 3000

[[ports]]
localPort = 35199
externalPort = 3002
exposeLocalhost = true

[[ports]]
localPort = 38239
externalPort = 6000
exposeLocalhost = true

[[ports]]
localPort = 40245
externalPort = 3001
exposeLocalhost = true

[[ports]]
localPort = 42925
externalPort = 4200
exposeLocalhost = true

[[ports]]
localPort = 43227
externalPort = 5000
exposeLocalhost = true

[[ports]]
localPort = 45079
externalPort = 3003
exposeLocalhost = true

[workflows]
runButton = "NutriMa Server"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[[workflows.workflow]]
name = "NutriMa Server"
author = 42644888
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"

[agent]
